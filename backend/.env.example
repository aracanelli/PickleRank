# Database
SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Clerk Auth
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=your-secret-key-for-rate-limiting

# Spond integration (server-only)
# Fernet key used to encrypt stored Spond credentials at rest. Required for the
# Spond integration; the feature is disabled if unset. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOND_ENCRYPTION_KEY=

# Environment
ENVIRONMENT=development
DEBUG=true







