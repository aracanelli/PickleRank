{
  "name": "pickleball-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "vue-tsc -b --force",
    "test:e2e": "playwright test",
    "dev:e2e": "vite --mode e2e --port 5199",
    "dev:e2e-real": "vite --mode e2e-real --port 5198"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.35.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@vueuse/core": "^12.0.0",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "lucide-vue-next": "^0.561.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.15.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
